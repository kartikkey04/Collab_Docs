# ─────────────────────────────────────────────
#  CollabDocs Backend — Environment Variables
#  Copy to .env and fill in your values.
# ─────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/collab_docs?schema=public"

# ── Redis ─────────────────────────────────────
REDIS_URL="redis://localhost:6380"

# ── Server ────────────────────────────────────
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# ── CORS (set to your frontend origin in production — never * in prod) ────────
CORS_ORIGIN=http://localhost:5173

# ── JWT ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_64_byte_random_hex_string
JWT_EXPIRY_SECONDS=604800

# ── Document save debounce (ms) ───────────────
DEBOUNCE_MS=2000

# ── AI Writing Assistant (Anthropic) ─────────
# Required for POST /ai/action. Get key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── App base URL (used in email links) ───────
APP_BASE_URL=http://localhost:5173

# ── SMTP (optional — for password reset emails) ──
# If not set, reset links are logged to console in development.
# Example config below uses Mailhog (local dev SMTP):
re_19tA9Xz6_557WvTZvU2VCBYpxUufxEV1V
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@collabdocs.app
# For production use Resend, Postmark, or SendGrid:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_...
